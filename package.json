{
  "name": "moonlit-werewolf",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/game/*.test.ts src/lib/server/*.test.ts",
    "audit:live": "tsx scripts/live-audit.ts",
    "tts:setup": "python3 scripts/setup-local-tts.py",
    "tts:start": "node scripts/start-local-tts.mjs",
    "tts:probe": "tsx scripts/local-tts-probe.ts",
    "tts:test": "python3 -m unittest discover -s services/local-tts -p 'test_*.py'",
    "stt:setup": "python3 scripts/setup-local-stt.py",
    "stt:start": "node scripts/start-local-stt.mjs",
    "stt:probe": "tsx scripts/local-stt-probe.ts",
    "stt:test": "python3 -m unittest discover -s services/local-stt -p 'test_*.py'"
  },
  "dependencies": {
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "lucide-react": "^0.562.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "tailwindcss": "^4.1.18",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
