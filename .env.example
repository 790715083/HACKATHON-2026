ZHIPU_API_KEY=your_bigmodel_standard_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_CHAT_MODEL=glm-5.3-flash
TTS_BASE_URL=http://127.0.0.1:8880/v1
TTS_MODEL=kokoro-v1.1-zh

# Default: offline inference on this machine. No STT API key is needed.
STT_PROVIDER=local
STT_BASE_URL=http://127.0.0.1:8881/v1
STT_MODEL=sensevoice-small-int8

# To use GLM ASR, set STT_PROVIDER=zhipu (uses ZHIPU_API_KEY/BASE_URL).
# ZHIPU_STT_MODEL=glm-asr-2512

# For a compatible external /audio/transcriptions API, set STT_PROVIDER=external
# and replace STT_BASE_URL / STT_MODEL above with that provider's values.
# STT_API_KEY=your_stt_only_server_key
